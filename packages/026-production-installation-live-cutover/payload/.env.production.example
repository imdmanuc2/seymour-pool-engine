SEYMOUR_PRODUCT_NAME=Seymour Pool Engine
SEYMOUR_VERSION=1.0.0-core
SEYMOUR_API_VERSION=v1
SEYMOUR_ENVIRONMENT=production
SEYMOUR_BIND_HOST=0.0.0.0
SEYMOUR_BIND_PORT=8561
SEYMOUR_LOG_LEVEL=info
SEYMOUR_DISPLAY_NAME=Seymour Bitcoin Pool
SEYMOUR_IDENTITY_FILE=/var/lib/seymour-pool-engine/installation-id
SEYMOUR_ENGINE_DATABASE_URL=postgresql://seymour_engine:CHANGE_ME@127.0.0.1:5432/seymour_pool_engine
SEYMOUR_BITCOIN_RPC_URL=http://127.0.0.1:8332
SEYMOUR_BITCOIN_RPC_URLS=
SEYMOUR_BITCOIN_RPC_USER=CHANGE_ME
SEYMOUR_BITCOIN_RPC_PASSWORD=CHANGE_ME
SEYMOUR_BITCOIN_RPC_TIMEOUT_SECONDS=10
SEYMOUR_BITCOIN_RPC_FAILURE_THRESHOLD=3
SEYMOUR_BITCOIN_RPC_COOLDOWN_SECONDS=30
SEYMOUR_BITCOIN_PAYOUT_SCRIPT=CHANGE_ME
SEYMOUR_BITCOIN_COINBASE_TAG=/Seymour/
SEYMOUR_STRATUM_ENABLED=true
SEYMOUR_STRATUM_HOST=0.0.0.0
SEYMOUR_STRATUM_PORT=3334
SEYMOUR_STRATUM_IDLE_TIMEOUT_SECONDS=300
SEYMOUR_STRATUM_MAX_CONNECTIONS=1000
SEYMOUR_STRATUM_MAX_LINE_BYTES=65536
SEYMOUR_STRATUM_DEFAULT_DIFFICULTY=1.0
SEYMOUR_STRATUM_EXTRANONCE2_SIZE=4
