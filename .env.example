SEYMOUR_PRODUCT_NAME=Seymour Pool Engine
SEYMOUR_VERSION=0.1.0
SEYMOUR_API_VERSION=v1
SEYMOUR_ENVIRONMENT=development

SEYMOUR_BIND_HOST=127.0.0.1
SEYMOUR_BIND_PORT=8561
SEYMOUR_LOG_LEVEL=info

SEYMOUR_DISPLAY_NAME=Seymour Pool
SEYMOUR_INSTANCE_ID=
SEYMOUR_IDENTITY_FILE=/var/lib/seymour-pool-engine/installation-id

SEYMOUR_ENGINE_DATABASE_URL=postgresql://seymour_engine:CHANGE_ME@127.0.0.1:5432/seymour_pool_engine
SEYMOUR_MININGCORE_DATABASE_URL=

SEYMOUR_MININGCORE_API_URL=http://127.0.0.1:4000
